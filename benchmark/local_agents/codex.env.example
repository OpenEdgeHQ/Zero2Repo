# Copy to codex.env and fill in. Then: source codex.env
#
# Codex reads OPENAI_* via cbrun setup (writes ~/.codex/auth.json + config.toml).
export OPENAI_API_KEY=
# export OPENAI_BASE_URL=https://your-openai-compatible-gateway/v1

# Model id passed to cbrun --model (keep provider/ prefix for gateways)
export MODEL=openai/gpt-4o-mini
