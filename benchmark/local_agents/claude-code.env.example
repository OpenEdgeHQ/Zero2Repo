# Copy to claude-code.env and fill in. Then: source claude-code.env
#
# Use ONE auth path:
#   - Subscription OAuth: CLAUDE_CODE_OAUTH_TOKEN (from `claude auth login` flow)
#   - API key: ANTHROPIC_API_KEY (and optional ANTHROPIC_BASE_URL)
#
# Do not set ANTHROPIC_* overrides when using OAuth (cbrun strips them).

# export CLAUDE_CODE_OAUTH_TOKEN=
# export ANTHROPIC_API_KEY=sk-ant-...

export MODEL=claude-sonnet-5
